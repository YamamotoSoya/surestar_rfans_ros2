<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- claude: ROS2 port of the vendor ROSDriver v2.3.18 (see git history: the
     pristine ROS1 import is the first commit; everything since is the port). -->
<package format="3">
  <name>surestar_rfans_ros2</name>
  <version>0.1.0</version>
  <description>
    ROS 2 driver for Sure-Star R-Fans / C-Fans LiDARs, ported from the vendor's
    open-source ROS1 ROSDriver v2.3.18 (bundled on the R-Fans-16 USB stick).
    Full open packet decode - no closed libstar.so.
  </description>
  <maintainer email="s25c1124xr@chibatech.ac.jp">YamamotoSoya</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>libpcap-dev</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
